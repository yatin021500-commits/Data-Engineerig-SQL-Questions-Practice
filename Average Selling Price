WITH abc AS (
    SELECT 
        p.product_id,
        p.price,
        u.units
    FROM Prices AS p
    LEFT JOIN UnitsSold AS u
        ON p.product_id = u.product_id
       AND u.purchase_date BETWEEN p.start_date AND p.end_date 
),
def AS (
    SELECT
        product_id,
        SUM(units) AS total 
    FROM UnitsSold
    GROUP BY product_id
)
SELECT
    a.product_id,
    COALESCE(ROUND(1.0 * SUM(a.units * a.price) / b.total, 2), 0) AS average_price
FROM abc AS a
LEFT JOIN def AS b 
    ON a.product_id = b.product_id
GROUP BY a.product_id, b.total;
